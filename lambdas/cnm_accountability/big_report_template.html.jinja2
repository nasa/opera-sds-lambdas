                        </p>
                    </td>
                    <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                        valign="top">
                        <p class="MsoNormal">
        <span style="mso-ligatures:none">
         {{ row.TOTAL_PRODUCTS.value }}
         <o:p>
         </o:p>
        </span>
                        </p>
                    </td>
                    {%- if row.CNM_UNSENT.severity == 0 %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
         <span style="mso-ligatures:none">
         {{ row.CNM_UNSENT.value }}
         <o:p>
         </o:p>
        </span>
                            </p>
                            {%- else %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:{{ colors[row.CNM_UNSENT.severity] }};padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
        <span style="color:black;mso-ligatures:none">
         {{ row.CNM_UNSENT.value }}
        </span>
                                <span style="mso-ligatures:none">
         <o:p>
         </o:p>
        </span>
                            </p>
                        </td>
                    {%- endif %}
                    {%- if row.CNM_SEND_FAILED.severity == 0 %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
         <span style="mso-ligatures:none">
         {{ row.CNM_SEND_FAILED.value }}
         <o:p>
         </o:p>
        </span>
                            </p>
                            {%- else %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:{{ colors[row.CNM_SEND_FAILED.severity] }};padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
        <span style="color:black;mso-ligatures:none">
         {{ row.CNM_SEND_FAILED.value }}
        </span>
                                <span style="mso-ligatures:none">
         <o:p>
         </o:p>
        </span>
                            </p>
                        </td>
                    {%- endif %}
                    {%- if row.CNM_NO_RESPONSE.severity == 0 %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
         <span style="mso-ligatures:none">
         {{ row.CNM_NO_RESPONSE.value }}
         <o:p>
         </o:p>
        </span>
                            </p>
                            {%- else %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:{{ colors[row.CNM_NO_RESPONSE.severity] }};padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
        <span style="color:black;mso-ligatures:none">
         {{ row.CNM_NO_RESPONSE.value }}
        </span>
                                <span style="mso-ligatures:none">
         <o:p>
         </o:p>
        </span>
                            </p>
                        </td>
                    {%- endif %}
                    {%- if row.CNM_INGEST_FAILED.severity == 0 %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
         <span style="mso-ligatures:none">
         {{ row.CNM_INGEST_FAILED.value }}
         <o:p>
         </o:p>
        </span>
                            </p>
                            {%- else %}
                        <td style="border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;background:{{ colors[row.CNM_INGEST_FAILED.severity] }};padding:0in 5.4pt 0in 5.4pt;height:18.55pt"
                            valign="top">
                            <p class="MsoNormal">
        <span style="color:black;mso-ligatures:none">
         {{ row.CNM_INGEST_FAILED.value }}
        </span>
                                <span style="mso-ligatures:none">
         <o:p>
         </o:p>
        </span>
                            </p>
                        </td>
                    {%- endif %}
                </tr>
            {%- endfor %}
            </tbody>
        </table>
        <p class="MsoNormal"><span style="mso-ligatures:none">&nbsp;<o:p></o:p></span></p>
        {%- if daac_accountability.ingestion_failures|length == 0 %}
            <p class="MsoNormal"><b><span style="mso-ligatures:none">No ingestion failures found!<o:p></o:p></span></b>
            </p>
        {%- else %}
            <p class="MsoNormal"><b><span style="mso-ligatures:none">-------------Ingestion Failures-------------<o:p></o:p></span></b>
                {%- for failure_report in daac_accountability.ingestion_failures %}
                    <p class="MsoNormal"><span style="mso-ligatures:none">&nbsp;<o:p></o:p></span></p>
                    <p class="MsoNormal"><span
                            style="mso-ligatures:none">Product type: <b>{{ failure_report.product }}</b> ({{ failure_report.product_count }}):<o:p></o:p></span>
                    </p>
                    <ul style="margin-top:0in" type="disc">
                        {%- for product in failure_report.products %}
                            <li class="MsoListParagraph" style="margin-left:0in;mso-list:l0 level1 lfo3"><span
                                    style="mso-ligatures:none">Product ID: {{ product.id }}
                                <o:p></o:p></span></li>
                            <ul style="margin-top:0in" type="circle">
                                <li class="MsoListParagraph" style="margin-left:0in;mso-list:l0 level2 lfo3"><span
                                        style="mso-ligatures:none">Status code: {{ product.error_code }}
                                    <o:p></o:p></span></li>
                                <li class="MsoListParagraph" style="margin-left:0in;mso-list:l0 level2 lfo3"><span
                                        style="mso-ligatures:none">Error message: {{ product.error_message }}
                                    <o:p></o:p></span></li>
                            </ul>
                        {%- endfor %}
                    </ul>
                    {%- if failure_report.skipped > 0 %}
                        <p class="MsoNormal">
                        <span style="mso-ligatures:none">&nbsp; (skipping {{ failure_report.skipped_str }} additional products for brevity – see attached JSON report for full list)<o:p></o:p></span>
                    {%- endif %}
                {%- endfor %}
        {%- endif %}
        <p class="MsoNormal"><span style="font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif"><o:p>&nbsp;</o:p></span>
        </p>

    {%- else %}
        {%- if daac_accountability.error_count == 1 %}
            <p class="MsoNormal">
                <b><span
                        style="color:black">Encountered an error while gathering report data: {{ daac_accountability.errors[0] }}
                    <o:p></o:p></span></b>
            </p>
        {%- else %}
            <p class="MsoNormal">
                <b><span style="color:black">Encountered errors while gathering report data:<o:p></o:p></span></b>
            </p>
            <ul type="disc">
                {% for err in daac_accountability.errors %}
                    <li class="MsoListParagraph" style="color:black;mso-list:l1 level1 lfo3">{{ err }}<b>
                        <o:p></o:p>
                    </b></li>
                {% endfor %}
            </ul>
        {%- endif %}
    {%- endif %}

    <div style="mso-element:para-border-div;border:none;border-bottom:solid windowtext 1.0pt;padding:0in 0in 1.0pt 0in">
        <p class="MsoNormal" style="border:none;padding:0in">
     <span style="font-size:14.0pt;color:black">
      <o:p>
      </o:p>
     </span>
        </p>
    </div>
    <p class="MsoNormal">
    <span style="font-size:14.0pt;color:black">
     <o:p>
     </o:p>
    </span>
    </p>
    <p class="MsoNormal">
    <span style="font-size:8.0pt;color:black">
     Report job ID: {{ general.gather_job_id }} ({{ general.gather_job_start_time }} to {{ general.gather_job_end_time }})
     <o:p>
     </o:p>
    </span>
    </p>
    <p class="MsoNormal">
    <span style="font-size:14.0pt;color:black">
     <o:p>
     </o:p>
    </span>
    </p>
    <p class="MsoNormal">
    <span style='font-size:14.0pt;font-family:"Calibri",sans-serif'>
     <o:p>
     </o:p>
    </span>
    </p>
</div>
</body>
</html>
